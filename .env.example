# AskAnswer environment template — copy to .env (gitignored).
# .env is the LOWEST-priority baseline. Precedence (high → low):
#   process env  >  .askanswer/settings.local.json  >  .askanswer/settings.json
#   >  ~/.askanswer/settings.json  >  .env
# Nothing is loaded at import time: configuration is bootstrapped lazily on first use
# (create_search_assistant(), first model call, get_persistence(), runtime_context_from_env()).
# Prefer structured config in settings.json when possible (see settings.example.json).

# --- Model provider ---------------------------------------------------------
OPENAI_API_KEY=your_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1
# Default model as "provider:name" (non-openai providers need their LangChain package).
# ASKANSWER_DEFAULT_MODEL=openai:gpt-5.4
# Per-role routing and fallback chains (comma-separated):
# ASKANSWER_MODEL_CLASSIFY=openai:gpt-4o-mini
# ASKANSWER_MODEL_EVALUATE=openai:gpt-4o-mini
# ASKANSWER_MODEL_SUMMARIZE=openai:gpt-4o-mini
# ASKANSWER_MODEL_ANSWER=openai:gpt-5.4
# ASKANSWER_MODEL_FALLBACKS_ANSWER=openai:gpt-4o,deepseek:deepseek-chat

# --- Tools ------------------------------------------------------------------
TAVILY_API_KEY=your_tavily_api_key_here
OPENWEATHER_API_KEY=your_openweather_api_key_here
# ASKANSWER_READ_FILE_MAX_BYTES=10485760
# ASKANSWER_WRITE_FILE_MAX_BYTES=1048576
# ASKANSWER_SHELL_OUTPUT_MAX_BYTES=65536
# Expose MCP tools to every intent (default: chat only).
# ASKANSWER_MCP_ALL_INTENTS=0

# --- SQL subagent -------------------------------------------------------------
# SQLAlchemy URL; ContextSchema(db_dsn=...) takes precedence.
# (WLANGGRAPH_POSTGRES_DSN is still read as a deprecated fallback.)
ASKANSWER_DB_DSN=postgresql://user:password@localhost:5432/dbname
# Optional. Leave blank to infer from the database connection.
ASKANSWER_DB_DIALECT=

# --- Persistence & tenancy ----------------------------------------------------
# ASKANSWER_DB_PATH=~/.askanswer/state.db
# ASKANSWER_TENANT_ID=

# --- Context & cost -----------------------------------------------------------
# ASKANSWER_CONTEXT_MAX_TOKENS=24000
# ASKANSWER_CONTEXT_DIGEST=off   # off | brief | llm
# ASKANSWER_RUN_TOKEN_BUDGET=60000

# --- Telemetry (optional: pip install -e ".[telemetry]") ----------------------
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=askanswer
# ASKANSWER_OTEL_EXPORTER=1
